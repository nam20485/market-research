.env
.venv/
__pycache__/
build/
dist/
*.egg-info/
.cursor/
node_modules/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.json

# Local SQLite cache (sold comps + identity lookups)
.cache/

# Frontend (built separately by the frontend worker)
frontend/node_modules/
frontend/dist/
frontend/coverage/

# Terraform (deploy/tf) — never commit state or vars containing secrets
# (.terraform.lock.hcl IS committed; it pins provider versions, no secrets)
deploy/tf/.terraform/
deploy/tf/*.tfstate
deploy/tf/*.tfstate.*
deploy/tf/*.tfvars
deploy/tf/*.tfvars.json
deploy/tf/crash.log
