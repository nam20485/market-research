# LiteLLM provider credentials (OpenAI shown; add other provider keys as needed)
OPENAI_API_KEY=

# Model identifiers passed to LiteLLM (provider-prefixed if not OpenAI, e.g. "anthropic/claude-3-5-sonnet")
LLM_MODEL=gpt-4o-mini
VISION_MODEL=gpt-4o-mini

# Web search provider used for market research and item identification lookups
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=

# Comma-separated list of allowed CORS origins for the frontend dev server / deployment
CORS_ORIGINS=http://localhost:5173
