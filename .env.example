# ── Inference (LiteLLM) ───────────────────────────────────────────────────────
# Model IDs are provider-prefixed for LiteLLM (e.g. "openai/...", "zai/...",
# "anthropic/..."). Use the "openai/<model>" prefix for ANY OpenAI-compatible
# endpoint, combined with LLM_API_BASE below.

# Chat model — market research + listing generation.
LLM_MODEL=gpt-4o-mini
# Optional: override the API base to any OpenAI-compatible endpoint.
LLM_API_BASE=
# Optional: API key. If blank, LiteLLM reads the provider's own env var
# (e.g. OPENAI_API_KEY for openai/*, ZAI_API_KEY for zai/*) from the environment.
LLM_API_KEY=

# Vision model — item identification (photos). VISION_API_BASE / VISION_API_KEY
# inherit LLM_API_BASE / LLM_API_KEY when blank, so one provider can serve both.
VISION_MODEL=gpt-4o-mini
VISION_API_BASE=
VISION_API_KEY=

# Plain-OpenAI convenience: used as the api_key fallback for both roles above.
OPENAI_API_KEY=

# ── Example: ClinePass with qwen3.7-plus (multimodal — one sub for both roles) ─
# Cline's API requires modelType/model (e.g. cline-pass/...). LiteLLM's openai/
# prefix is routing-only and is stripped before the request. Verify images with:
#   uv run python scripts/check_vision.py
#   LLM_MODEL=openai/cline-pass/qwen3.7-plus
#   LLM_API_BASE=https://api.cline.bot/api/v1
#   LLM_API_KEY=<your ClinePass key>               # or export LLM_API_KEY=$CLINE_API_KEY
#   VISION_MODEL=openai/cline-pass/qwen3.7-plus    # base/key inherited from LLM_* above
#
# ── Example: Z.AI GLM Coding Plan (text chat) + separate vision provider ──────
# The coding plan serves only text models, so point VISION_* elsewhere.
#   LLM_MODEL=zai/glm-4.7
#   LLM_API_BASE=https://api.z.ai/api/coding/paas/v4   # key from $ZAI_API_KEY in env
#   VISION_MODEL=openai/gpt-4o-mini                    # needs OPENAI_API_KEY

# ── Web search (market research + item lookups) ───────────────────────────────
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=

# ── eBay sold comps (market research pricing) ─────────────────────────────────
# Used to compute fair-market-value from real sold listings via SerpApi's eBay
# engine. Sign up at https://serpapi.com/ for a key. Leave the key blank (or set
# COMPS_ENABLED=false) to gracefully degrade to the LLM-estimated FMV fallback.
# SERPAPI_KEY is also accepted as an alias for this same setting (useful when
# the key happens to already be exported under that name in your shell/CI).
COMPS_PROVIDER=serpapi
COMPS_ENABLED=true
COMPS_MAX_RESULTS=8
SERPAPI_API_KEY=

# ── Local cache (sold comps + identity lookups) ────────────────────────────────
# Stdlib SQLite by default; keeps SerpApi/search calls cheap during dev. Not
# durable across Cloud Run's scale-to-zero instances — that's acceptable for
# now (see AGENTS.md). Set CACHE_ENABLED=false to disable caching entirely.
CACHE_ENABLED=true
CACHE_BACKEND=sqlite
CACHE_DB_PATH=.cache/market_research.sqlite3
CACHE_TTL_COMPS_SECONDS=604800      # 7 days
CACHE_TTL_IDENTITY_SECONDS=2592000  # 30 days

# ── Pricing defaults (dynamic pricing / haggle strategy) ───────────────────────
# Listing price = FMV * (1 + DEFAULT_HAGGLE_PCT); firm-bottom = FMV * (1 -
# DEFAULT_FLOOR_PCT). Both are overridable per-request from the frontend.
DEFAULT_HAGGLE_PCT=0.15
DEFAULT_FLOOR_PCT=0.10

# ── Marketplace auto-fill (local-only) ────────────────────────────────────────
# Fills a listing form via an MCP server so you can review and submit manually.
# Facebook Marketplace uses chrome-devtools-mcp (your own already-running Chrome);
# OfferUp uses appium-mcp (an Android emulator). Both require Node/npx locally
# and do NOT work against a Cloud Run deployment — set POSTING_ENABLED=false there
# (or leave it true; the frontend hides the button once /api/post/capabilities
# reports enabled=false, e.g. because Chrome/npx/emulator aren't reachable).
#
# Chrome backend (Facebook Marketplace): Chrome 144+ beta, remote debugging enabled
# once at chrome://inspect/#remote-debugging.
POSTING_ENABLED=true
CHROME_MCP_COMMAND=npx
CHROME_MCP_CHANNEL=beta
CHROME_MCP_EXTRA_ARGS=
#
# Appium backend (OfferUp): Android SDK + emulator (emulator running, OfferUp app
# installed + logged in), JDK 8+, ANDROID_HOME set. Leave APPIUM_ANDROID_HOME blank
# to inherit ANDROID_HOME from the process environment.
APPIUM_MCP_COMMAND=npx
APPIUM_MCP_EXTRA_ARGS=
APPIUM_ANDROID_HOME=
APPIUM_EMULATOR_NAME=
# Falls back to LLM_MODEL when blank. Must be a tool-calling-capable chat model
# (the default gpt-4o-mini works; a text-only ZAI model would not).
POSTING_MODEL=
POSTING_MAX_STEPS=40

# ── CORS: comma-separated allowed origins for the frontend ────────────────────
# In production this must include the deployed Cloudflare Pages origin (e.g.
# https://market-research.pages.dev, or a custom domain if you attach one) —
# keep it in sync with the `frontend_origin` Terraform variable in deploy/tf/.
CORS_ORIGINS=http://localhost:5173

# ── Logging (optional) ────────────────────────────────────────────────────────
# Backend log level for the `app.*` loggers (DEBUG, INFO, WARNING, ERROR).
# LOG_LEVEL=INFO
