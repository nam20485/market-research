# Confirmed false positives for market-research initial commit.
# Prefer specific line: EREs; keep live secrets (and real .env) failing the scan.

# Empty pydantic Settings defaults — values come from env / .env, not hardcoded
line:openai_api_key:[[:space:]]*str[[:space:]]*=[[:space:]]*""
line:tavily_api_key:[[:space:]]*str[[:space:]]*=[[:space:]]*""
line:llm_api_key:[[:space:]]*str[[:space:]]*=[[:space:]]*""
line:vision_api_key:[[:space:]]*str[[:space:]]*=[[:space:]]*""

# OpenAI-compatible call wiring — parameter names / empty kwargs, not live secrets
line:api_key=call_kwargs\.get\("api_key",[[:space:]]*""\)
line:api_key:[[:space:]]*str,

# FastAPI CORSMiddleware boolean flag — not a credential
line:allow_credentials=True

# Docs / tests — placeholders and fake keys only
line:LLM_API_KEY=<clinepass[[:space:]]key>
line:llm_api_key="clp-key"
line:vision_api_key="vk"
line:openai_api_key="sk-fallback"
line:"api_key":[[:space:]]*"vk"
line:llm_api_key="test-key"

# Terraform provider wiring — references to variables, not secret literals
line:api_token[[:space:]]*=[[:space:]]*var\.cloudflare_api_token
line:token[[:space:]]*=[[:space:]]*var\.github_token

# Terraform github_actions_secret resources — secret *names*, not values
line:secret_name[[:space:]]*=[[:space:]]*"CLOUDFLARE_API_TOKEN"
line:secret_name[[:space:]]*=[[:space:]]*"CLOUDFLARE_ACCOUNT_ID"
line:secret_name[[:space:]]*=[[:space:]]*"GCP_SA_KEY"

# Terraform Secret Manager — resource IDs / refs (values added out-of-band via gcloud)
line:app_secret_ids[[:space:]]*=[[:space:]]*\[
line:secret_id[[:space:]]*=[[:space:]]*each\.value
line:secret_id[[:space:]]*=[[:space:]]*each\.value\.secret_id
line:secret[[:space:]]*=[[:space:]]*env\.value\.secret_id

# GitHub Actions — ${{ secrets.* }} references, not embedded credentials
line:apiToken:[[:space:]]*\$\{\{[[:space:]]*secrets\.CLOUDFLARE_API_TOKEN[[:space:]]*\}\}
line:password:[[:space:]]*\$\{\{[[:space:]]*secrets\.GITHUB_TOKEN[[:space:]]*\}\}
line:credentials_json:[[:space:]]*\$\{\{[[:space:]]*secrets\.GCP_SA_KEY[[:space:]]*\}\}

# Template env file with empty placeholders (safe to commit; real .env stays gitignored/blocked)
path:.env.example

# pnpm lockfile — npm package name "js-tokens", not a credential
line:js-tokens:[[:space:]]*[0-9]
